# PageCap — environment configuration (12-factor III: config from the
# environment, never hardcoded). Copy to `.env` and adjust. Every variable is
# optional; the defaults shown are what the code uses when unset.

# ── Security ────────────────────────────────────────────────────────────────
# The token required on every route except the /health probes, and on the /ws
# WebSocket. Sent as `Authorization: Bearer <token>` or, for URLs the browser
# fetches by itself (<img src>, <a download>, WebSocket), as `?token=<token>`.
#
# Leave it unset and the engine GENERATES one on first boot and persists it to
# `.pagecap_token` next to the database — auth is on by default, not opt-in.
# Retrieve it with:  python cli.py token --show
# The Electron app ignores this and injects a fresh random token per launch.
# PAGECAP_API_TOKEN=

# Escape hatch: 0 disables authentication entirely. This is the pre-ADR-001
# behaviour and is UNSAFE on a machine that runs a web browser — any page the
# user visits can then drive this API. Slated for removal; see
# docs/adr/ADR-001. Logged loudly on every boot when set.
# PAGECAP_REQUIRE_AUTH=1

# Encryption key for stored passwords / TOTP secrets / raw cookies
# (crypto_box.py). Must be 32 bytes, urlsafe-base64 encoded, e.g.
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Unset = a key file `.pagecap_key` is generated next to the database (0600).
# PAGECAP_SECRET_KEY=

# Allow browser requests whose Origin is the literal string "null".
# DANGEROUS without PAGECAP_API_TOKEN: every sandboxed iframe on every website
# sends Origin: null, so this hands any page a cross-origin read of this API.
# Only the packaged Electron renderer (file://) legitimately needs it.
# PAGECAP_ALLOW_NULL_ORIGIN=0

# Extra CORS origins, comma-separated. A bare "*" is always ignored.
# PAGECAP_CORS_ORIGINS=

# Requests per minute per client IP. 0 disables rate limiting.
# PAGECAP_RATE_LIMIT_PER_MINUTE=0

# ── Storage ─────────────────────────────────────────────────────────────────
# SQLite file holding job history, credential profiles, templates, schedules.
# The generated API token (.pagecap_token) and encryption key (.pagecap_key)
# are written alongside it, so this path decides where all local state lives.
# PAGECAP_DB_PATH=pagecap.db

# Where extracted files are written (one subdirectory per job).
# PAGECAP_DOWNLOADS_DIR=downloads

# Finished jobs older than this are evicted: DB row + downloads/<job_id>/.
# Active jobs are never evicted regardless of age. Default 3 days.
# PAGECAP_JOB_TTL_SECONDS=259200

# How often the eviction sweep runs.
# PAGECAP_EVICTION_INTERVAL_SECONDS=3600

# Minimum seconds between persisting an in-flight job's state to SQLite.
# Terminal states and status changes always persist immediately.
# PAGECAP_PERSIST_INTERVAL_SECONDS=2.0

# ── Scheduler / shutdown ────────────────────────────────────────────────────
# How often stored ScheduleConfig rows are checked for due runs.
# PAGECAP_SCHEDULER_INTERVAL_SECONDS=30

# On SIGTERM, how long to let in-flight jobs stop cooperatively before they are
# cancelled outright (12-factor IX). Raise it if jobs routinely mux large
# videos, since ffmpeg needs time to finalise a file.
# PAGECAP_SHUTDOWN_DRAIN_SECONDS=20

# ── Extensibility ───────────────────────────────────────────────────────────
# Directory of custom extractor plugins (see plugins.py). Every *.py file there
# is imported and executed in-process — treat it as trusted code.
# PAGECAP_PLUGINS_DIR=

# ── Observability ───────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR. Structured JSON to stderr.
# PAGECAP_LOG_LEVEL=INFO
